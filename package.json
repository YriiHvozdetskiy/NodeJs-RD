{
  "name": "marketplace-api",
  "version": "0.1.0",
  "private": true,
  "description": "Курсовий проєкт — Marketplace API. ДЗ#9: OpenAPI-контракт + runtime-валідація на кордоні. ДЗ#11: zod-схема env із fail-fast, секрети поза git і поза образом, ротація пароля БД без рестарту. ДЗ#12: схема Postgres, seed на 200k замовлень, 4 запити з EXPLAIN до/після, повнотекстовий пошук по каталогу.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && node dist/main.js",
    "start:dev": "ts-node -P tsconfig.json src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:scope": "redocly bundle openapi/openapi.yaml -o spec.json && node scripts/check-scope.js",
    "check:env": "tsc -p tsconfig.json && node scripts/check-env-example.mjs",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec -w / db psql -U admin -d marketplace",
    "db:bench": "bash scripts/db-bench.sh",
    "rotate": "bash rotate.sh"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "express": "5.2.1",
    "express-openapi-validator": "5.6.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
