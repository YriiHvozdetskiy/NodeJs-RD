{
  "name": "mini-nest",
  "version": "1.0.0",
  "private": true,
  "description": "Лекції 6-7 — власний mini-Nest: IoC-контейнер на метаданих + HTTP-шар на декораторах",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/main.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  }
}
