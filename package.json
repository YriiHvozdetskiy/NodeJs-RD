{
  "name": "marketplace-api",
  "version": "0.1.0",
  "private": true,
  "description": "Курсовий проєкт — Marketplace API. ДЗ#9: OpenAPI-контракт + runtime-валідація на кордоні. ДЗ#11: zod-схема env із fail-fast, секрети поза git і поза образом, ротація пароля БД без рестарту. ДЗ#12: схема Postgres, seed на 200k замовлень, 4 запити з EXPLAIN до/після, повнотекстовий пошук по каталогу. ДЗ#13: TypeORM entities + relations + міграції, ідемпотентний seed, N+1 до/після, звіт через QueryBuilder.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "rm -rf dist-test && tsc -p tsconfig.test.json",
    "start": "tsc -p tsconfig.json && node dist/main.js",
    "start:dev": "ts-node -P tsconfig.json src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check:scope": "redocly bundle openapi/openapi.yaml -o spec.json && node scripts/check-scope.js",
    "check:env": "tsc -p tsconfig.json && node scripts/check-env-example.mjs",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec -w / db psql -U admin -d marketplace",
    "db:bench": "bash scripts/db-bench.sh",
    "rotate": "bash rotate.sh",
    "migrate": "bash scripts/with-secrets.sh dev typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev typeorm migration:revert -d dist/data-source.js",
    "migrate:generate": "bash scripts/with-secrets.sh dev typeorm migration:generate -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "demo:realtime": "node scripts/realtime-demo.mjs",
    "consumer": "bash scripts/with-secrets.sh dev node dist/consumer.js",
    "backup": "bash scripts/with-secrets.sh dev bash scripts/backup.sh",
    "drill": "bash scripts/with-secrets.sh dev bash scripts/restore-drill.sh",
    "test:integration": "npm run build:test && jest dist-test/test/integration",
    "test:e2e": "npm run build:test && jest dist-test/test/e2e",
    "test:contract": "npm run build:test && jest dist-test/test/contract/consumer",
    "verify:provider": "npm run build:test && jest dist-test/test/contract/provider",
    "pact:gate": "bash scripts/pact-broker.sh gate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/platform-socket.io": "11.2.1",
    "@nestjs/websockets": "11.2.1",
    "amqplib": "2.0.1",
    "express": "5.2.1",
    "express-openapi-validator": "5.6.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "typeorm": "0.3.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@pact-foundation/pact": "17.1.4",
    "@redocly/cli": "2.46.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "jest": "30.5.2",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
