{
  "name": "mini-nest",
  "version": "1.0.0",
  "private": true,
  "description": "Лекції 6-8 — власний mini-Nest: IoC-контейнер, HTTP-шар на декораторах, повний lifecycle запиту",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "npm run build && node dist/src/main.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  }
}
