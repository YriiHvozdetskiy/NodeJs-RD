# ─── Контракт конфігурації Marketplace API ──────────────────────────────────
# Цей файл живе в git і є ПОВНИМ списком змінних застосунку. Реальні значення
# живуть у .env, якого в git немає.
#
#   cp .env.example .env      ← перший крок після клонування
#
# Правила:
#   1. Кожна змінна зі схеми (src/config/env.schema.ts) є тут — навіть
#      опціональна, з дефолтом у коментарі.
#   2. Секретні значення тут ФЕЙКОВІ або відсутні. Ніколи не справжні.
#   3. Додав змінну в схему → додай сюди В ТОМУ Ж КОМІТІ. Інакше
#      `npm run check:env` червоний, а в колеги після git pull сервіс не стартує.
#
# Пароль до Postgres сюди не входить свідомо: він не змінна оточення, а файл
# (DB_PASSWORD_FILE). Чому саме так — README, розділ «Configuration».

# Режим роботи: development | test | production. Опціональна, дефолт development.
NODE_ENV=development

# Порт HTTP-сервера. Опціональна, дефолт 3000.
PORT=3000

# Рівень логування: debug | info | warn | error. Опціональна, дефолт info.
LOG_LEVEL=info

# ОБОВ'ЯЗКОВА. Куди підключатись до Postgres — БЕЗ пароля.
# Формат: postgres://user@host:port/database
# Значення нижче відповідає docker-compose.yml із цього репозиторію.
DB_URL=postgres://app_user@127.0.0.1:5432/marketplace

# Файл, з якого читається пароль БД. Шлях відносний до кореня репозиторію.
# Опціональна, дефолт ./secrets/db_password. Сам файл — у .gitignore.
DB_PASSWORD_FILE=./secrets/db_password

# Скільки з'єднань тримає пул pg. Опціональна, дефолт 10.
DB_POOL_MAX=10

# Демо з ДЗ#9: 1 — обробник навмисно віддає totalCents замість total_cents,
# щоб було видно, як валідатор відповідей ловить дрейф. Дефолт 0.
DRIFT=0

# Демо з ДЗ#9: штучна затримка в POST /orders у мілісекундах — без неї гілка
# 409 «idempotency-key-in-flight» фізично недосяжна. Дефолт 0.
SLOW_MS=0
