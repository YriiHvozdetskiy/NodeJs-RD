# ❌ НАВМИСНО ПОГАНИЙ. Потрібен рівно для одного: показати в README,
# скільки важить той самий застосунок, зібраний «в лоб» однією стадією.
# Збірка: docker build -f Dockerfile.naive -t hw05-naive .
#
# Порівняння з основним Dockerfile — вимога ДЗ, пункт 8.

FROM node:24
#    ↑ повний образ, а не slim: тягне gcc, python3, git, make — усе те,
#      що потрібно рівно один раз під час npm install і ніколи в рантаймі

WORKDIR /app

COPY . .
#    ↑ увесь код ДО встановлення залежностей: змінили один рядок у src/ —
#      і згорів кеш усього, що нижче, включно з npm install

RUN npm install && npm run build
#    ↑ install замість ci: може відійти від lock-файлу.
#      А головне — dev-залежності (typescript, @types/*) лишаються в образі
#      назавжди, разом із вихідними .ts, які після збірки вже нікому не треба

CMD npm start
#    ↑ shell-форма: PID 1 стає /bin/sh, який не передає SIGTERM у node.
#      docker stop чекає 10 секунд і добиває SIGKILL.
#      Ще й працює від root — uid 0
