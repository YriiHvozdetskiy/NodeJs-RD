# syntax=docker/dockerfile:1

# ═══════════════════════ СТАДІЯ 1 — builder ═══════════════════════
# Тут можна все: dev-залежності, компілятор, сміття від збірки.
# Жоден шар цієї стадії не потрапить у фінальний образ — з неї заберуть
# рівно те, що явно скопіюють через `--from=builder`.
FROM node:24-slim AS builder

WORKDIR /app

# СПЕРШУ маніфести, і тільки потім код. Docker кешує кожну інструкцію
# за хешем її входів: доки package.json і package-lock.json не змінились,
# наступний шар зі встановленням залежностей береться з кешу за мілісекунди.
COPY package.json package-lock.json ./

# `ci`, а не `install`: читає lock-файл як істину і не переписує його.
# Тут ставимо ВСЕ, включно з typescript і @types/* — вони потрібні для tsc.
RUN npm ci

# І аж тепер код. Змінили рядок у src/ — згорить лише цей шар і те, що нижче;
# шар зі встановленням вище лишиться в кеші. node_modules сюди не потрапляє: його
# ріже .dockerignore, інакше хостові бінарники під macOS/arm64 затерли б
# щойно встановлені linux-збірки.
COPY . .

# tsc -> /app/dist. Це і є артефакт, заради якого існує ця стадія.
RUN npm run build


# ═══════════════════════ СТАДІЯ 2 — runner ════════════════════════
# Фінальний образ. Починається з ЧИСТОГО node:24-slim — усе, що наросло
# в builder (typescript, @types/*, вихідні .ts, tsconfig.json), лишається
# в тій стадії й у результат не їде.
FROM node:24-slim AS runner

WORKDIR /app

# Не лише про перформанс: Express із production вимикає докладні сторінки
# помилок зі стектрейсами, а npm нижче за замовчуванням не ставить devDependencies.
ENV NODE_ENV=production

# Той самий патерн, що в builder: маніфести окремим шаром і раніше за артефакт.
# Порядок саме такий, бо dist/ змінюється щодня, а package-lock.json — раз на тиждень.
# Постав ми копіювання dist вище — кожна правка коду перевстановлювала б залежності.
COPY package.json package-lock.json ./

# --omit=dev — ключова відмінність від builder: typescript і @types/* сюди не їдуть.
# Кеш npm після встановлення осів би окремим шаром на десятки мегабайтів,
# тому чистимо його в ТІЙ САМІЙ інструкції: видалення окремим RUN не поверне
# місце — шари незмінні, файл лишиться жити в нижньому шарі.
RUN npm ci --omit=dev && npm cache clean --force

# Єдине, що переїжджає з builder — готовий JS. --chown одразу віддає файли
# користувачу node: інакше вони належали б root, і будь-яка спроба записати
# щось поруч (лог, кеш, тимчасовий файл) впала б із EACCES.
COPY --from=builder --chown=node:node /app/dist ./dist

# Образ node:* уже містить користувача node з uid 1000 — створювати нічого не треба.
# Усе, що нижче цього рядка, і сам процес контейнера працюють від нього, не від root.
USER node

# Один порт за замовчуванням на весь образ: його читає і сервер (src/server.ts),
# і HEALTHCHECK нижче. Задасте PORT ззовні — обидва поїдуть за ним разом.
ENV PORT=3000

# Суто документація: порт назовні відкриває compose, а не ця інструкція.
EXPOSE 3000

# curl і wget у slim-образі відсутні — б'ємо власним node, який тут точно є.
# Порт беремо з оточення, а не константою: інакше запуск із -e PORT=8080 лишив би
# контейнер unhealthy назавжди — перевірка стукала б у порт, якого ніхто не слухає.
# start-period дає процесу піднятись, і невдачі в цьому вікні не рахуються
# в retries; далі перевірка кожні 10 с, тож healthy настає значно раніше за 30 с.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "const p = process.env.PORT || 3000; fetch('http://127.0.0.1:' + p + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

# Exec-форма (JSON-масив): node стає PID 1 і отримує SIGTERM напряму.
# Shell-форма (CMD npm start) підсунула б туди /bin/sh, який сигнал не передає,
# і кожна зупинка коштувала б 10 секунд очікування перед SIGKILL.
CMD ["node", "dist/server.js"]
