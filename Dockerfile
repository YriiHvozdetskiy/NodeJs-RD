# syntax=docker/dockerfile:1

# ═══════════════════ Чому тут ОДНА стадія, а в ДЗ#5 було дві ═══════════════════
# У ДЗ#5 у прод їхав довгоживучий HTTP-сервер, і сенс двостадійності був у тому,
# щоб typescript і @types/* лишились у builder і не поїхали в runtime.
#
# Тут артефакт інший: бібліотека плюс її тести. Єдина команда, заради якої існує
# цей образ, — `npm test`, а вона запускає tsc. Викинути devDependencies означало б
# викинути саму мету образу. Тому стадія одна, і це рішення, а не недогляд.
# Kеш-патерн (маніфести окремим шаром раніше за код) лишається той самий.
FROM node:24-slim

# WORKDIR створює теку від root, а процес нижче працює від node — і tsc не зміг би
# записати dist/. Тому власника віддаємо ДО того, як переходимо на непривілейованого
# користувача, а не після.
RUN mkdir -p /app && chown node:node /app
WORKDIR /app

# Далі все — від node (uid 1000, уже є в образі node:*). Заразом це рятує від
# node_modules, що належить root: інакше будь-яка спроба переставити пакет упала б.
USER node

# СПЕРШУ маніфести, і тільки потім код: доки package-lock.json не змінився,
# шар із npm ci береться з кешу за мілісекунди.
COPY --chown=node:node package.json package-lock.json ./

# `ci`, а не `install`: читає lock-файл як істину і не переписує його.
RUN npm ci

# І аж тепер код. Правка в src/ гасить лише цей шар і те, що нижче.
COPY --chown=node:node . .

# Exec-форма: node стає PID 1 і отримує сигнали напряму.
# `docker compose run --rm api npm test` перекриє цю команду тим самим значенням —
# дефолт тут для того, щоб `docker compose up` теж робив осмислену річ.
CMD ["npm", "test"]
