{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    // Пишемо в коді './db.ts' — так це бачить і `node --watch src/server.ts`
    // (Node сам зрізає типи), і tsc, який при збірці перепише шлях на './db.js'.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
